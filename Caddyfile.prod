
{
    email wjdrb0626@naver.com
}

# The canonical site. Caddy obtains and renews the Let's Encrypt certificate
# automatically and stores it in the caddy_data volume.
bustal.kr {
    tls {
        protocols tls1.2
    }

    reverse_proxy web:3000 {
        transport http {
            versions 1.1 2
        }
    }
    encode gzip
    # Security headers
    header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "no-referrer-when-downgrade"
    # Upgrade insecure requests to HTTPS and allow typical resources
    header Content-Security-Policy "upgrade-insecure-requests; default-src 'self' 'unsafe-inline' https: data:"
}

# Keep HTTP redirects explicit so the public contract is a 301 (rather than
# Caddy's default automatic-HTTPS 308), while preserving path and query.
http://bustal.kr {
    redir https://bustal.kr{uri} 301
}

http://www.bustal.kr, https://www.bustal.kr {
    redir https://bustal.kr{uri} 301
}

# Keep the old certificate active while the old hostname is migrated.
http://bustal-time.kro.kr, https://bustal-time.kro.kr {
    redir https://bustal.kr{uri} 301
}
